rules_version = '2';

// ClearWalls catalog: clients read the catalog, may only CREATE reports.
// Deploy: Firebase console -> Firestore -> Rules (paste), or `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /curated_wallpapers/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /editor_picks/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /categories/{doc} {
      allow read: if true;
      allow write: if false;
    }
    // In-app content reporting (Play AI-GC policy): create-only, size-capped.
    match /reports/{doc} {
      allow create: if request.resource.data.keys().hasAll(['contentId', 'contentType', 'reason'])
                    && request.resource.data.contentId is string
                    && request.resource.data.contentId.size() < 200
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() < 200;
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
